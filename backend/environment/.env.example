# BillFlow Backend — Environment Variables (see docs/BillFlow_Dev_Technical_Spec.md, Section 9)
#
# HOW TO USE (run from the backend/ directory):
#   cp environment/.env.example environment/.env      then fill in the real values below.
#
# This .example file IS committed (it documents required vars, no secrets).
# The real .env is git-ignored and must NEVER be committed.

# ───────────────────────── Server ─────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin allowed by CORS. Angular dev server locally; Netlify URL in prod.
CLIENT_URL=http://localhost:4200

# ─────────────────── Database (MongoDB Atlas) ──────────────
# Local:  mongodb://127.0.0.1:27017/billflow
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/billflow?retryWrites=true&w=majority
MONGODB_URI=

# ───────────────────── Auth / JWT (Spec Section 8) ─────────
# Access token = 15 min, refresh token = 7 days (refresh stored in an httpOnly cookie).
# Generate strong values:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# bcrypt cost factor for password hashing (higher = more secure but slower).
BCRYPT_SALT_ROUNDS=10

# ────────────── Email (SendGrid, @sendgrid/mail) ──────────
# SENDGRID_API_KEY: create at https://app.sendgrid.com/settings/api_keys (Mail Send permission).
# EMAIL_FROM must be a SendGrid-VERIFIED sender/domain, or sends are rejected.
# If SENDGRID_API_KEY is left blank, the app runs in DRY-RUN mode (composes but never sends) —
# handy for local dev and tests.
SENDGRID_API_KEY=
EMAIL_FROM="BillFlow <no-reply@billflow.app>"
